  <string name="pref_group_camera_idle">Camera Sleep Mode</string>
  <string name="pref_title_camera_idle_enabled">Enable sleep mode</string>
  <string name="pref_summary_camera_idle_enabled">Camera capture receives no standby signal from the TV, so a powered-off screen keeps streaming sensor noise to the strip. When enabled, the LEDs turn off once the picture goes blank, and frame transmission pauses until the picture returns. Disabled by default.</string>
  <string name="pref_title_camera_idle_timeout">Sleep delay (seconds)</string>
  <string name="pref_title_camera_idle_dark_level">Blank screen threshold (0–96)</string>
  <string name="pref_title_camera_idle_motion_level">Motion sensitivity threshold (1–64)</string>
  <string name="pref_title_camera_idle_static">Sleep on a static picture</string>
  <string name="pref_summary_camera_idle_static">When enabled, frame transmission also pauses if the picture stops changing (e.g. a paused video or a static menu); the strip retains its last displayed colors. Disabled by default, as an extended static scene will freeze the strip\'s colors.</string>
